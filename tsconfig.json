{
  "compilerOptions": {
    "target": "ES2025",
    "module": "Preserve",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "incremental": true,
    "skipLibCheck": true
  },
  "include": ["evals", "vieval.config.ts"],
  "exclude": ["node_modules", "dist"]
}
